# For manual deposits only, start with --piggybank.drip-enabled=false.
# Otherwise, the scheduler also creates and tops up Bobby's separate piggybank.
# Deposits and withdrawals address the ownerId, as in FamilyApi and the commands.

@baseUrl = http://localhost:8080
@ownerId = 4b3fa27a-5839-40dd-a05a-a62c71e610d7

### Create a piggybank (201)
POST {{baseUrl}}/piggybanks
Content-Type: application/json

{
  "ownerId": "{{ownerId}}"
}

### Deposit money (200 with the updated balance)
POST {{baseUrl}}/piggybanks/{{ownerId}}/deposits
Content-Type: application/json

{
  "amount": 10
}

### Withdraw money (200 with the updated balance; refused when the balance is too low)
POST {{baseUrl}}/piggybanks/{{ownerId}}/withdrawals
Content-Type: application/json

{
  "amount": 5
}

### List all piggybanks with their owner and balance
GET {{baseUrl}}/piggybanks
Accept: application/json
